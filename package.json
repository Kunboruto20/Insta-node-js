{
  "name": "insta-node-js",
  "version": "2.0.1",
  "description": "Fast and effective Instagram Private API wrapper for Node.js, written in TypeScript, with realtime MQTT support",
  "author": "Kunboruto20",
  "license": "MIT",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20.9"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\"",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --import tsx --test test/*.test.ts",
    "prepare": "npm run build",
    "prepublishOnly": "npm test && npm run clean && npm run build"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Kunboruto20/Insta-node-js.git"
  },
  "keywords": [
    "instagram",
    "instagram-private-api",
    "instagram-api",
    "instagram-client",
    "mqtt",
    "realtime",
    "direct",
    "typescript"
  ],
  "dependencies": {
    "@hapi/boom": "^10.0.1",
    "sharp": "^0.35.5",
    "socks": "^2.8.3",
    "undici": "^6.29.1"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3"
  },
  "optionalDependencies": {
    "ffmpeg-static": "^5.3.0",
    "ffprobe-static": "^3.1.0"
  },
  "homepage": "https://github.com/Kunboruto20/Insta-node-js#readme",
  "bugs": {
    "url": "https://github.com/Kunboruto20/Insta-node-js/issues"
  },
  "publishConfig": {
    "access": "public"
  }
}
